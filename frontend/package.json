    "lucide-react": "^1.8.0",
    "midi-player-js": "^2.0.17",
    "next": "16.2.7",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "opensheetmusicdisplay": "^1.9.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-masonry-css": "^1.0.16",
    "recharts": "^3.8.1",
    "shadcn": "^4.3.1",
    "soundfont-player": "^0.12.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
