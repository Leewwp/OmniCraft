# OmniCraft production environment template.
# Copy to /opt/omnicraft/.env on the server, fill every value with real
# secrets and never commit the filled file. Placeholders are rejected by
# scripts/release/preflight.sh. Field names mirror backend/config/config.go
# (OverrideFromEnv) and docs/deploy/production-config-template.md.

# --- PostgreSQL (compose network; sslmode=disable is allowed only for the
# internal, unexposed PgBouncer host — see OMNICRAFT_PRIVATE_DB_HOSTS) ---
POSTGRES_USER=omnicraft
POSTGRES_PASSWORD=<strong-postgres-password>
POSTGRES_DB=omnicraft
# Must be a registry-verified immutable reference; do not use :latest or a tag.
PGBOUNCER_IMAGE=edoburu/pgbouncer@sha256:<registry-verified-digest>
DB_DSN=host=pgbouncer port=5432 user=omnicraft password=<strong-postgres-password> dbname=omnicraft sslmode=disable
OMNICRAFT_PRIVATE_DB_HOSTS=pgbouncer

# --- Redis ---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=<strong-redis-password>
REDIS_DB=0

# --- JWT / key encryption ---
JWT_SECRET=<openssl-rand-hex-64>
LLM_KEY_ENCRYPTION_SECRET=<openssl-rand-hex-64>

# --- Origins ---
ALLOWED_ORIGINS=https://app.leeppp.online

# --- Aliyun OSS ---
OSS_ENDPOINT=https://oss-<region>.aliyuncs.com
OSS_ACCESS_KEY_ID=<oss-ram-access-key-id>
OSS_ACCESS_KEY_SECRET=<oss-ram-access-key-secret>
OSS_BUCKET_NAME=<private-bucket-name>
OSS_DOMAIN=https://<bucket-name>.oss-<region>.aliyuncs.com

# --- Content security (Green) ---
GREEN_ACCESS_KEY_ID=<green-ram-access-key-id>
GREEN_ACCESS_KEY_SECRET=<green-ram-access-key-secret>
GREEN_REGION=cn-shanghai
GREEN_CALLBACK_URL=https://api.leeppp.online/api/v1/internal/ai-callback
# Callback signature seed ([A-Za-z0-9_], max 64 chars). A generated template
# value is provided; deployers may replace it before first launch.
GREEN_SEED=eGvqrYixTEzFRDUToSd1lgy3plgaMJDqr0X5Ji7P4TY
# Aliyun MAIN account UID from the console top-right account info (not the RAM UID).
GREEN_UID=<aliyun-main-account-uid>

# --- CAPTCHA ---
CAPTCHA_ACCESS_KEY_ID=<captcha-ram-access-key-id>
CAPTCHA_ACCESS_KEY_SECRET=<captcha-ram-access-key-secret>

# --- SMTP (password only; mode/host/user/from live in the override YAML) ---
SMTP_PASSWORD=<smtp-password-or-app-password>

# --- Observability ---
LOG_IP_HASH_SECRET=<openssl-rand-hex-64>
LOG_IP_KEY_ID=<rotation-key-id>

# --- Agent (keep disabled for Web Beta) ---
AGENT_LLM_API_KEY=

# --- Frontend build/runtime URLs (validated by preflight) ---
NEXT_PUBLIC_API_URL=https://api.leeppp.online
INTERNAL_API_URL=https://api.leeppp.online
NEXT_PUBLIC_SITE_URL=https://app.leeppp.online

# --- Operator override YAML mounted read-only into the backend container ---
CONFIG_OVERRIDE_PATH=/app/config_override.yaml

# --- Observability compose-only inputs ---
METRICS_TEXTFILE_DIR=/var/lib/omnicraft/metrics
OBS_LOG_DIR=/var/log/containers
OBS_GATE_TOKEN=<operator-obs-gate-token>
ALERTMANAGER_CONFIG_FILE=/var/lib/omnicraft/alertmanager.yml
