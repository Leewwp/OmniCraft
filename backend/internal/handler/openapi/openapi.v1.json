        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageGuide"
                }
              }
            }
          },
          "404": {
            "description": "Not found (for id-addressed resources)",
