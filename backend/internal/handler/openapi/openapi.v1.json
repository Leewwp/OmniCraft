      "get": {
        "summary": "Get usage guide",
        "description": "Merged usage-guide view: repo-versioned system template overlaid with author-confirmed specifics. ETag + s-maxage=300.",
        "operationId": "get_usage_guide",
        "parameters": [
          {
            "name": "id",
            "in": "path",
