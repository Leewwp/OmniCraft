{
  "openapi": "3.1.0",
  "info": {
    "title": "OmniCraft Public API",
    "version": "1.0.0",
    "summary": "Anonymous read-only subset of the OmniCraft content platform, for external agents and integrations.",
    "description": "Stable v1 contract of the anonymous read surface. Everything here is reachable without credentials and rate-limited per IP. Within v1 no response field is removed or repurposed; breaking changes ship as v2 with a deprecation period. Content visibility: only published, public content from non-banned authors under non-banned IPs is ever returned. Caching: anonymous GET responses carry Cache-Control (public, s-maxage=300) and an ETag honouring If-None-Match revalidation."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/contents": {
      "get": {
        "summary": "List contents",
        "description": "Paginated public content listing. Only anonymous-visible content is returned.",
        "operationId": "list_contents",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100
            }
          },
          {
            "name": "zone",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "original",
                "fanwork"
              ]
            }
          },
          {
            "name": "content_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "contents": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ContentListItem"
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "page_size": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer",
                      "format": "int64"
                    }
                  },
                  "required": [
                    "contents",
                    "total"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found (for id-addressed resources)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/contents/search": {
      "get": {
        "summary": "Search contents",
        "description": "Keyword search over anonymous-visible content. Rate limited per IP (search bucket).",
        "operationId": "search_contents",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Keyword query on title/description."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 50
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Content type filter."
          },
          {
            "name": "time_range",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ContentListItem"
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "page_size": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "total_pages": {
                      "type": "integer"
                    },
                    "time_range": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "items",
                    "total"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found (for id-addressed resources)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/contents/{id}": {
      "get": {
        "summary": "Get content detail",
        "description": "Full public view of one content item. 404 for non-public content (unpublished, private, soft-deleted, banned).",
        "operationId": "get_content_detail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
