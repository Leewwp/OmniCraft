{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omnicraft-migration-metadata",
  "title": "OmniCraft migration metadata contract",
  "type": "object",
  "required": ["schema_version", "default_transactional", "self_transactional", "non_transactional"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "default_transactional": { "const": true },
    "self_transactional": {
      "type": "array",
      "items": { "$ref": "#/$defs/declaredMigration" }
    },
    "non_transactional": {
      "type": "array",
      "items": { "$ref": "#/$defs/declaredMigration" }
    }
  },
  "$defs": {
    "declaredMigration": {
      "type": "object",
      "required": [
        "filename",
        "reason",
        "reviewer",
        "reviewed_at",
        "preconditions",
        "postconditions",
        "idempotent_resume",
        "reconciliation"
      ],
      "properties": {
        "filename": { "type": "string", "pattern": "^\\d{3}_[a-z0-9_]+\\.sql$" },
        "reason": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
        "preconditions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sqlCondition" } },
        "postconditions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sqlCondition" } },
        "idempotent_resume": { "type": "string", "minLength": 1 },
        "reconciliation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sqlCondition": {
      "type": "object",
      "required": ["description", "query"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "query": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
