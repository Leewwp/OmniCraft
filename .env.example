# Database
DB_DSN=host=localhost port=5432 user=omnicraft password=omnicraft dbname=omnicraft sslmode=disable
DB_READ_DSN=

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (MUST change in production)
JWT_SECRET=your-very-secret-jwt-key-change-in-production
LLM_KEY_ENCRYPTION_SECRET=

# Aliyun OSS (required for file uploads)
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET_NAME=omnicraft
OSS_DOMAIN=https://omnicraft.oss-cn-hangzhou.aliyuncs.com

# Aliyun Content Security (required for content review)
GREEN_ACCESS_KEY_ID=your-access-key-id
GREEN_ACCESS_KEY_SECRET=your-access-key-secret
GREEN_REGION=cn-shanghai
GREEN_CALLBACK_URL=
GREEN_SEED=
GREEN_UID=

# Security - CORS allowed origins (comma-separated, production MUST specify exact domains)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# CAPTCHA
CAPTCHA_ACCESS_KEY_ID=
CAPTCHA_ACCESS_KEY_SECRET=

# SMTP
SMTP_PASSWORD=

# Agent — canonical profile (docs/reference/agent-runtime-matrix.md).
# Chat: MiniMax-M3 via the minimax adapter (api.minimaxi.com, no trailing /v1).
# Embedding: DashScope text-embedding-v4@1536 via a separate openai_compat
# embedding provider. The split wiring requires its own embedding key and is
# fail-closed: the embedding credential must not borrow the MiniMax chat key.
# Keep values blank / local_disabled for the normal local demo; real provider
# evidence is opt-in with a short-lived, budget-limited key.
AGENT_LLM_API_KEY=
AGENT_WEB_AGENT_ENABLED=false
AGENT_LLM_PROVIDER=minimax
AGENT_LLM_MODEL=MiniMax-M3
AGENT_LLM_API_BASE=https://api.minimaxi.com
AGENT_EMBEDDING_PROVIDER=openai_compat
AGENT_EMBEDDING_MODEL=text-embedding-v4
AGENT_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode
AGENT_EMBEDDING_API_KEY=
# Must match AGENT_EMBEDDING_MODEL for hybrid RAG; auto-mirrored when omitted.
RAG_INDEX_EMBEDDING_MODEL=text-embedding-v4
AGENT_HMAC_SECRET=

# RAG rerank chain (A-03): primary DashScope qwen3-rerank, optional
# SiliconFlow bge-reranker-v2-m3 fallback. Empty rerank keys keep the rerank
# leg off (RRF order) until the A-04 ablation flips the feature defaults.
#RAG_RERANK_API_KEY=
#RAG_RERANK_FALLBACK_API_KEY=

# DashScope key for the corpus/eval harness (scripts/corpus); the Go services
# read only the AGENT_*/RAG_* variables above.
#DASHSCOPE_API_KEY=

# Config override path
CONFIG_OVERRIDE_PATH=data/config_override.yaml
