# Database
DB_DSN=host=localhost port=5432 user=omnicraft password=omnicraft dbname=omnicraft sslmode=disable
DB_READ_DSN=

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (MUST change in production)
JWT_SECRET=your-very-secret-jwt-key-change-in-production
LLM_KEY_ENCRYPTION_SECRET=

# Aliyun OSS (required for file uploads)
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET_NAME=omnicraft
OSS_DOMAIN=https://omnicraft.oss-cn-hangzhou.aliyuncs.com

# Aliyun Content Security (required for content review)
GREEN_ACCESS_KEY_ID=your-access-key-id
GREEN_ACCESS_KEY_SECRET=your-access-key-secret
GREEN_REGION=cn-shanghai
GREEN_CALLBACK_URL=
GREEN_SEED=
GREEN_UID=

# Security - CORS allowed origins (comma-separated, production MUST specify exact domains)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# CAPTCHA
CAPTCHA_ACCESS_KEY_ID=
CAPTCHA_ACCESS_KEY_SECRET=

# SMTP
SMTP_PASSWORD=

# Agent
# Keep these values blank or local_disabled for the normal local demo. Real
# provider evidence is opt-in and must use a short-lived, budget-limited key.
AGENT_LLM_API_KEY=
AGENT_WEB_AGENT_ENABLED=false
AGENT_LLM_PROVIDER=minimax
AGENT_LLM_MODEL=MiniMax-M3
AGENT_LLM_API_BASE=https://api.minimaxi.com
AGENT_EMBEDDING_MODEL=embo-01
# MiniMax legacy embedding API; it is separate from the Chat base URL.
AGENT_EMBEDDING_API_BASE=https://api.minimax.chat
# Required by the legacy embedding endpoint. Obtain this from the MiniMax API account.
AGENT_EMBEDDING_GROUP_ID=
# Must match AGENT_EMBEDDING_MODEL for hybrid RAG. The application mirrors the
# value automatically when this variable is omitted; set it explicitly in an
# evidence run so the model identity is visible in the captured environment.
RAG_INDEX_EMBEDDING_MODEL=embo-01
AGENT_HMAC_SECRET=

# Config override path
CONFIG_OVERRIDE_PATH=data/config_override.yaml
