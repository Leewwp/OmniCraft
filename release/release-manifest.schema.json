{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OmniCraft release manifest",
  "description": "Machine-readable release manifest binding commit, version, artifact digests, migration manifest, SBOM digests, pinned generators and provenance references. Generated by scripts/release/generate-sbom.sh and verified by scripts/release/verify-provenance.sh.",
  "type": "object",
  "required": [
    "schema_version",
    "commit",
    "version",
    "created_at",
    "generators",
    "components",
    "artifacts",
    "migration_manifest",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Release manifest schema version"
    },
    "preview": {
      "type": "boolean",
      "description": "True for unsigned PR preview manifests that lack container components"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Git commit the release candidate was built from"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Release version string (semver-ish)"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Manifest creation time, UTC ISO 8601"
    },
    "generators": {
      "type": "object",
      "required": ["syft"],
      "properties": {
        "syft": {
          "type": "object",
          "required": ["image", "tag", "version", "digest"],
          "properties": {
            "image": { "type": "string" },
            "tag": { "type": "string" },
            "version": { "type": "string" },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "ecosystem", "source", "sbom_path", "sbom_sha256"],
        "properties": {
          "id": { "type": "string" },
          "ecosystem": { "type": "string", "enum": ["go", "npm", "rust", "container"] },
          "source": { "type": "string" },
          "sbom_path": { "type": "string" },
          "sbom_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "path", "sha256"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["container-image", "binary"] },
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "image": { "type": "string" },
          "tag": { "type": "string" }
        }
      }
    },
    "migration_manifest": {
      "type": "object",
      "required": ["path", "sha256", "count"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "scope", "builder_id", "subject", "verify_command"],
        "properties": {
          "type": { "type": "string", "const": "github-attestation" },
          "scope": { "type": "string", "enum": ["preview", "release"] },
          "builder_id": { "type": "string", "pattern": "^https://github\\.com/omnicraft/omnicraft/.github/workflows/sbom\\.yml@refs/.+" },
          "subject": { "type": "string", "minLength": 1 },
          "verify_command": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
