{
  "schema_version": 1,
  "description": "Alert rule contract for ops/observability/prometheus-rules.yml. Every rule must declare owner, severity, a pending window (for), summary, impact, first resolution step and a runbook anchor, and may only reference metrics from the allowlist.",
  "required_rule_fields": ["alert", "expr", "for"],
  "required_labels": ["owner", "severity"],
  "allowed_severities": ["critical", "warning", "info"],
  "required_annotations": ["summary", "impact", "first_step", "runbook"],
  "for_regex": "^[0-9]+[smhd]$",
  "runbook_anchor_regex": "^docs/deploy/single-server-beta-runbook\\.md#",
  "promql_keywords": [
    "and", "or", "unless", "by", "on", "ignoring", "group_left", "group_right",
    "offset", "bool", "without", "rate", "increase", "irate", "sum", "avg",
    "min", "max", "count", "stddev", "stdvar", "quantile", "histogram_quantile",
    "abs", "absent", "ceil", "clamp_max", "clamp_min", "changes", "delta",
    "deriv", "exp", "floor", "hour", "idelta", "label_join", "label_replace",
    "ln", "log10", "log2", "minute", "month", "predict_linear", "resets",
    "round", "scalar", "sort", "sort_desc", "sqrt", "time", "timestamp",
    "vector", "year", "avg_over_time", "min_over_time", "max_over_time",
    "sum_over_time", "count_over_time", "quantile_over_time", "stddev_over_time",
    "stdvar_over_time", "last_over_time", "present_over_time", "topk", "bottomk",
    "day_of_month", "day_of_week", "days_in_month", "atan", "acos", "asin",
    "cos", "sin", "tan", "sgn", "pi", "e", "phi", "smooth_exponential"
  ],
  "allowed_metrics": [
    "omnicraft_http_requests_total",
    "omnicraft_http_request_duration_seconds_bucket",
    "omnicraft_http_request_duration_seconds_sum",
    "omnicraft_http_request_duration_seconds_count",
    "omnicraft_panics_total",
    "omnicraft_queue_backlog",
    "omnicraft_queue_worker_failures_total",
    "omnicraft_migration_status",
    "omnicraft_migration_last_success_timestamp_seconds",
    "omnicraft_external_dependency_requests_total",
    "omnicraft_external_dependency_duration_seconds_bucket",
    "omnicraft_external_dependency_duration_seconds_sum",
    "omnicraft_external_dependency_duration_seconds_count",
    "omnicraft_db_pool_open_connections",
    "omnicraft_db_pool_in_use_connections",
    "omnicraft_db_pool_idle_connections",
    "omnicraft_db_pool_wait_count_total",
    "omnicraft_db_pool_max_open_connections",
    "omnicraft_db_pool_max_idle_closed_total",
    "omnicraft_db_pool_max_lifetime_closed_total",
    "omnicraft_redis_pool_total_connections",
    "omnicraft_redis_pool_idle_connections",
    "omnicraft_redis_pool_stale_connections",
    "omnicraft_backup_status",
    "omnicraft_backup_last_success_timestamp_seconds",
    "omnicraft_recovery_drill_status",
    "omnicraft_recovery_drill_last_success_timestamp_seconds",
    "up",
    "pg_up",
    "pg_stat_database_numbackends",
    "redis_up",
    "probe_success",
    "probe_ssl_earliest_cert_expiry",
    "node_filesystem_avail_bytes",
    "node_filesystem_size_bytes",
    "node_time_seconds",
    "container_start_time_seconds"
  ],
  "exporter_targets_required": [
    "postgres-exporter",
    "redis-exporter",
    "node-exporter",
    "cadvisor",
    "blackbox"
  ]
}
